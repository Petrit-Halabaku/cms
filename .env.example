# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email for form notifications)
RESEND_API_KEY=

# Address that receives contact/quote notifications
NOTIFY_EMAIL=

# Optional validated map overrides; otherwise use CMS coordinates
NEXT_PUBLIC_MAP_LAT=
NEXT_PUBLIC_MAP_LNG=
NEXT_PUBLIC_MAPS_CID=
